local function DoQuestFlower()
    local Character = Player.Character or Player.CharacterAdded:Wait()
    local HRP = Character:WaitForChild("HumanoidRootPart")
    
    local mapFolder = Workspace:FindFirstChild("Map")
    if not mapFolder then return false end
    
    local flowerPrompts = {}
    for _, desc in ipairs(mapFolder:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Name == "FlowerPrompt" and desc.Parent then
            local part = desc:FindFirstAncestorWhichIsA("BasePart")
            if part and part.Transparency == 0 then table.insert(flowerPrompts, desc) end
        end
    end
    
    if #flowerPrompts == 0 then return false end
    
    for idx, prompt in ipairs(flowerPrompts) do
        if CurrentActiveQuest ~= "Quest1" then return false end
        if prompt and prompt.Parent then
            local part = prompt:FindFirstAncestorWhichIsA("BasePart")
            if part then
                HRP.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                HRP.Velocity = Vector3.new(0, 0, 0) 
                task.wait(1)
                for i = 1, 5 do
                    if CurrentActiveQuest ~= "Quest1" then break end
                    if prompt and prompt.Parent then
                        fireproximityprompt(prompt)
                        task.wait(0.4)
                    end
                end
                task.wait(1)
            end
        end
    end
    return true
end

