local function GatekeeperCheck()
    UpdateCurrenciesAndStatsFromMemory()
    
    if StatsDataCache and type(StatsDataCache.GamesWon) == "number" then
        if StatsDataCache.GamesWon < 25 then
            warn("⚠️ 25Win Not Reached! Changing account ID...")
            getgenv().TriggerAccountChange("Change Account (Not 25Win)")
            return false
        end
    end

    local SetUnitEquippedRF = ReplicatedStorage:WaitForChild("RemoteFunctions"):WaitForChild("SetUnitEquipped")

    local invData = nil
    while not invData do
        invData = ScanRAMForInventory()
        if not invData then task.wait(1.5) end
    end

    local raffUID, tridentUID, tomatoUID = nil, nil, nil
    local equippedUIDs = {}

    for _, item in ipairs(invData) do
        if item.name == "unit_rafflesia" then raffUID = item.uid end
        if item.name == "unit_trident" then tridentUID = item.uid end
        if item.name == "unit_tomato_plant" then tomatoUID = item.uid end
        if item.equipped then table.insert(equippedUIDs, item.uid) end
    end

    if not raffUID or not tridentUID or not tomatoUID then
        local missing = {}
        if not raffUID then table.insert(missing, "Rafflesia") end
        if not tridentUID then table.insert(missing, "Trident") end
        if not tomatoUID then table.insert(missing, "Tomato") end
        
        local missingStr = table.concat(missing, " & ")
        warn("⚠️ No " .. missingStr .. " found! Changing account ID...")
        getgenv().TriggerAccountChange("Change Account (No " .. missingStr .. ")")
        return false 
    end
    
    for _, uid in ipairs(equippedUIDs) do
        pcall(function() SetUnitEquippedRF:InvokeServer(uid, false) end)
        task.wait(0.2)
    end

    pcall(function() SetUnitEquippedRF:InvokeServer(raffUID, true) end)
    task.wait(0.3)
    pcall(function() SetUnitEquippedRF:InvokeServer(tridentUID, true) end)
    task.wait(0.3)
    pcall(function() SetUnitEquippedRF:InvokeServer(tomatoUID, true) end)
    
    return true
end

