    local function fxvol() pcall(function() RemoteFunctions.ChangeSetting:InvokeServer("st_fx_volume", 1) end) end

    local function activateAutoSkip()
        task.spawn(function()
            local gui = Player.PlayerGui:WaitForChild("GameGuiNoInset", 30)
            if not gui then return end
            local btn = gui:WaitForChild("Screen", 10):WaitForChild("Top", 10):WaitForChild("WaveControls", 10):WaitForChild("AutoSkip", 10)
            if not btn then return end
            local title = btn:WaitForChild("Title", 10)

            while task.wait(1) do
                if forceRestartMatch then break end 
                if title.Text == "Auto Skip: Off" then
                    pcall(function() for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do conn:Fire() end end)
                end
            end
        end)
    end

    local function waitUntilCash(target) 
        local gui = Player:WaitForChild("PlayerGui"):WaitForChild("GameGui", 60)
        if not gui then return end
        local screen = gui:WaitForChild("Screen", 60)
        if not screen then return end
        local bottom = screen:WaitForChild("Bottom", 60)
        if not bottom then return end
        local currencyDisplay = bottom:WaitForChild("CurrencyDisplay", 60)
        if not currencyDisplay then return end
        local cashLabel = currencyDisplay:WaitForChild("Cash", 60)
        if not cashLabel then return end
        
        while true do 
            if forceRestartMatch then return end
            local cleanCashStr = cashLabel.Text:gsub("[^%d]", "")
            local currentCash = tonumber(cleanCashStr) or 0
            if currentCash >= target then break end
            task.wait(0.3) 
        end 
    end
    
    local function findNewUnitId(unitName) 
        unitName = unitName or "unit_tomato_plant"
        for _, u in pairs(Workspace.Map.Entities:GetChildren()) do 
            local id = u:GetAttribute("ID")
            if u.Name == unitName and id and not placedUnits[id] then 
                placedUnits[id] = u
                return id 
            end 
        end
        return nil 
    end
    
    local function placeUnitSafe(basePos) 
        local id = nil
        repeat 
            if forceRestartMatch then return nil end
            local ang = math.random() * math.pi * 2
            local r = math.sqrt(math.random()) * 1.5
            local tPos = Vector3.new(basePos.X + math.cos(ang) * r, basePos.Y, basePos.Z + math.sin(ang) * r)
            
            pcall(function() 
                PlaceUnit:InvokeServer("unit_tomato_plant", {
                    Valid = true, PathIndex = 1, Position = tPos, 
                    DistanceAlongPath = 0, CF = CFrame.new(tPos), Rotation = 180
                }) 
            end)
            
            task.wait(0.5)
            id = findNewUnitId("unit_tomato_plant") 
        until id ~= nil or forceRestartMatch
        return id 
    end
    
    local function upgradeUnitById(id) 
        if id and placedUnits[id] then pcall(function() UpgradeUnit:InvokeServer(id) end) end 
    end

    local function again()
        pcall(function() RemoteFunctions.RestartGame:InvokeServer() end)
    end

    local function monitorBaseHP()
        task.spawn(function()
            local map = Workspace:WaitForChild("Map", 60)
            if not map then return end
            local baseHP = map:WaitForChild("BaseHP", 60)
            if not baseHP then return end
            local function checkHP()
                pcall(function()
                    local val = baseHP.Value
                    if tonumber(val) and tonumber(val) <= 0 and not forceRestartMatch then
                        forceRestartMatch = true
                        task.wait(3)
                        again()
                    end
                end)
            end
            checkHP()
            pcall(function() hpConnection = baseHP.Changed:Connect(checkHP) end)
        end)
    end

    RemoteEvents.ShowGameEnd.OnClientEvent:Connect(function()
        if not forceRestartMatch then
            forceRestartMatch = true
            task.wait(3)
            again()
        end
    end)

    local function runSession()
        forceRestartMatch = false
        placedUnits = {}
        if hpConnection then hpConnection:Disconnect(); hpConnection = nil end
        monitorBaseHP()
        activateAutoSkip()

        if not hasAppliedSettings then
            hasAppliedSettings = true
            task.spawn(function()
                low(); mvol(); fxvol()
                x2()
            end)
        end

        task.wait(2)
        pcall(function() RemoteFunctions:WaitForChild("PlaceDifficultyVote"):InvokeServer("dif_easy") end)
        task.wait(5)
        
        for i = 1, 15 do 
            if forceRestartMatch then break end
            local id = placeUnitSafe(unitBases[i])
            if id then 
                waitUntilCash(125); upgradeUnitById(id)
                waitUntilCash(175); upgradeUnitById(id)
                waitUntilCash(350); upgradeUnitById(id)
                waitUntilCash(500); upgradeUnitById(id) 
            end
            task.wait(0.2) 
        end
        
        while not forceRestartMatch do task.wait(0.5) end
    end

    while CurrentActiveQuest == "Quest2" do
        runSession()
        task.wait(2)
    end
end

