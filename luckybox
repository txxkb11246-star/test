            if StatsDataCache and type(StatsDataCache.GamesWon) == "number" then
                if StatsDataCache.GamesWon >= 25 then winStr = "✅" end
            end
            table.insert(logParts, string.format("🏆 25Win: %s", winStr))
        end
        if LogDisplayConfig.ShowRafflesia then table.insert(logParts, string.format("🌸 Raff: %s", hasRaff and "✅" or "❌")) end
        if LogDisplayConfig.ShowTomatoPlant then table.insert(logParts, string.format("🍅 Tomato: %s", hasTomato and "✅" or "❌")) end
        if LogDisplayConfig.ShowTrident then table.insert(logParts, string.format("🔱 Trident: %d", tridentCount)) end
        
        local questName = "Loading..."
        if CurrentActiveQuest == "Quest1" then questName = "Flower"
        elseif CurrentActiveQuest == "Quest2" then questName = "MapFarm"
        elseif CurrentActiveQuest == "AllDone" then questName = "AllDone"
        end
        table.insert(logParts, string.format("📜 Quest: %s", questName))

        table.insert(logParts, string.format("⛔ %s", reason))
        
        local desc = table.concat(logParts, " , ")
        local json_data = { ["Quest"] = desc }
        local encode_json = HttpService:JSONEncode(json_data)
        
        pcall(function() _G.Horst_SetDescription(desc, encode_json) end)
        print("📝 [Horst] Force Updated Log:", desc)
    end
    
    if _G.Horst_AccountChangeDone then
        local ok, err = pcall(function() return _G.Horst_AccountChangeDone() end)
        if ok then print("✅ [Horst] Sent change ID command:", reason) else print("❌ [Horst] Failed:", tostring(err)) end
    end
end
