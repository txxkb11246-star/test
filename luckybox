-- [[ 4. ระบบ Auto Quest Scanner & State Manager ]] --
-- ==================================================================
task.spawn(function()
    local function safeFind(parent, pathTable)
        local current = parent
        for _, name in ipairs(pathTable) do
            current = current:FindFirstChild(name)
            if not current then return nil end
        end
        return current
    end
    
    local function getGuiPaths()
        local PlayerGui = Player:FindFirstChild("PlayerGui")
        if not PlayerGui then return nil, nil end
        local GameGui = PlayerGui:FindFirstChild("GameGui")
        if not GameGui then return nil, nil end
        
        local collectablesBtn = safeFind(GameGui, {"Screen", "Left", "Sidebar", "Items", "Collectables", "Items", "Button"})
        local scrollingFrame = safeFind(GameGui, {"Screen", "Middle", "Collectables", "Items", "Frame", "Top", "ScrollingFrame"})
        return collectablesBtn, scrollingFrame
    end

    local function clickButton(button)
        local clicked = false
        if getconnections then
            for _, connection in ipairs(getconnections(button.MouseButton1Click)) do
                if type(connection.Fire) == "function" then connection:Fire(); clicked = true
                elseif type(connection.Function) == "function" then connection.Function(); clicked = true end
            end
        end
        if not clicked and firesignal then firesignal(button.MouseButton1Click) end
    end

    local function isDataLoaded(scrollingFrame)
        for _, child in ipairs(scrollingFrame:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "Template" and child.Name:match("^cl_") then return true end
        end
        return false
    end

    local function getAvailableCount(itemNode)
        local ownedNode = itemNode:FindFirstChild("Button") and itemNode.Button:FindFirstChild("Owned")
        if ownedNode and ownedNode:IsA("TextLabel") then
            local rawText = ownedNode.Text
            local _, m2 = rawText:match("(%d+)%s*owned%s*/%s*(%d+)%s*available")
            if m2 then return tonumber(m2) end
            _, m2 = rawText:match("(%d+)%s*/%s*(%d+)")
            if m2 then return tonumber(m2) end
        end
        return 999 
    end

    while true do
        local collectablesBtn, scrollingFrame = getGuiPaths()
        if collectablesBtn and scrollingFrame then
            -- บังคับเปิด UI
            clickButton(collectablesBtn)
            task.wait(1)
            
            -- กดเลือก Tab lucky26 (Part 1)
            local gameGui = Player:WaitForChild("PlayerGui", 5):FindFirstChild("GameGui")
            if gameGui then
                local tab = gameGui.Screen.Middle.Collectables:FindFirstChild("Right") and gameGui.Screen.Middle.Collectables.Right:FindFirstChild("lucky26")
                if tab then
                    clickButton(tab)
                    task.wait(1)
                end
            end
            
            if isDataLoaded(scrollingFrame) then
                task.wait(1)
                
                -- Check Quest 1 (Flower)
                local item_flower = scrollingFrame:FindFirstChild("cl_lucky26_flower")
                local q1_done = false
                if item_flower then
                    q1_done = (getAvailableCount(item_flower) == 0)
                end
                
                -- Check Quest 2 (MapFarm + Victory)
                local item_mapfarm = scrollingFrame:FindFirstChild("cl_lucky26_mapfarm")
                local item_victory = scrollingFrame:FindFirstChild("cl_lucky26_victory")
                local q2_farm_done = false
                local q2_vic_done = false
                
                if item_mapfarm then q2_farm_done = (getAvailableCount(item_mapfarm) == 0) end
                if item_victory then q2_vic_done = (getAvailableCount(item_victory) == 0) end
                local q2_done = (q2_farm_done and q2_vic_done)

                -- State Machine Decision
                if not q1_done then
                    CurrentActiveQuest = "Quest1"
                    print("[QuestScanner] 🟡 สถานะ: Quest1 (เก็บดอกไม้)")
                elseif not q2_done then
                    CurrentActiveQuest = "Quest2"
                    print("[QuestScanner] 🟡 สถานะ: Quest2 (ลงฟาร์ม)")
                else
                    CurrentActiveQuest = "AllDone"
                    print("[QuestScanner] 🟢 สถานะ: AllDone (เควสทั้งหมดที่ทำไว้สำเร็จแล้ว)")
                end
                
                clickButton(collectablesBtn)
            end
        end
        task.wait(30)
    end
end)

