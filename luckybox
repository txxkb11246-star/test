local function UpdateCurrenciesAndStatsFromMemory()
    pcall(function()
        if Player then
            ReplicatedStorage:WaitForChild("RemoteFunctions"):WaitForChild("GetPlayerDisplayProfile"):InvokeServer(Player.Name)
        end
    end)
    
    local gc = getgc(true)
    for i = 1, #gc do
        local obj = gc[i]
        if type(obj) == "table" then
            local seeds = rawget(obj, "Seeds")
            if type(seeds) == "number" then
                local tickets = rawget(obj, "Tickets")
                if type(tickets) == "number" then
                    PlayerDataCache = obj
                end
            end
            
            local gamesWon = rawget(obj, "GamesWon")
            if type(gamesWon) == "number" then
                local timePlayed = rawget(obj, "TotalTimePlayed")
                if type(timePlayed) == "number" then
                    StatsDataCache = obj
                end
            end
        end
    end
    table.clear(gc)
    gc = nil
end

local function UpdateCurrenciesFromMemory()
    pcall(function()
        UpdateCurrenciesAndStatsFromMemory()
        if PlayerDataCache then
            if PlayerDataCache.Seeds then cachedSeedsText = tostring(PlayerDataCache.Seeds) end
            if PlayerDataCache.LuckyBlocks then cachedLuckyBlocksText = tostring(PlayerDataCache.LuckyBlocks) end
            if PlayerDataCache.Tickets then cachedTicketsText = tostring(PlayerDataCache.Tickets) end
        end
    end)
end

local function ScanRAMForInventory()
    if type(getgc) ~= "function" then return nil end

    local gc = getgc(true)
    local inventoryTable = nil

    for _, obj in ipairs(gc) do
        if type(obj) == "table" then
            pcall(function()
                for key, value in pairs(obj) do
                    if type(key) == "string" and string.find(key, "unique_") and type(value) == "table" then
                        if value.ItemData and type(value.ItemData) == "table" and value.ItemData.ID then
                            inventoryTable = obj
                            break
                        end
                    end
                end
            end)
            if inventoryTable then break end
        end
    end

    if inventoryTable then
        local parsedInv = {}
        pcall(function()
            for uid, data in pairs(inventoryTable) do
                if type(uid) == "string" and string.find(uid, "unique_") then
                    table.insert(parsedInv, {
                        uid = uid,
                        name = data.ItemData.ID or "Unknown",
                        equipped = data.Equipped == true
                    })
                end
            end
        end)
        table.clear(gc)
        gc = nil
        if #parsedInv > 0 then return parsedInv end
    end
    
    table.clear(gc)
    gc = nil
    return nil
end

local function HasRafflesia()
    local invData = ScanRAMForInventory()
    if invData then
        for _, item in ipairs(invData) do
            if item.name == "unit_rafflesia" then return true end
        end
    end
    return false
end

local function HasTomatoPlant()
